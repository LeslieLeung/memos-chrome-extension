{
  "name": "memos-chrome-extension",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Create and clip Memos directly from Chrome.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:dist": "node scripts/validate-dist.mjs",
    "version:sync": "node scripts/sync-version.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/chrome": "^0.0.326",
    "@types/node": "^22.15.0",
    "eslint": "^9.30.0",
    "globals": "^16.2.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
